{
  "name": "flash-courier-mobile",
  "version": "1.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-print": "~58.0.9",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-thermal-printer-driver": "^0.1.1",
    "with-rn-bluetooth-classic": "^1.0.5",
    "@upng/upng-js": "^2.2.2"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-bluetooth-classic",
          "react-native-thermal-printer-driver",
          "with-rn-bluetooth-classic"
        ],
        "listUnknownPackages": false
